{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaw.local/contracts/project-manifest.v0.4.schema.json",
  "title": "ADAW Draft Project Manifest v0.4",
  "description": "Draft shape for G0/G1; not frozen protocol. Canonical hash and plugin restore contracts in 04-PROJECT-AND-REVISION-CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "timebase",
    "arrangement_end_tick",
    "tracks",
    "buses",
    "master_bus_id",
    "processors",
    "modules",
    "assets",
    "plugin_references",
    "quality_profile_id"
  ],
  "properties": {
    "schema_version": {
      "const": "adaw.project@0.4"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ppq",
        "bpm",
        "numerator",
        "denominator",
        "sample_rate"
      ],
      "properties": {
        "ppq": {
          "type": "integer",
          "const": 960
        },
        "bpm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8,
            16,
            32
          ]
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000
        }
      }
    },
    "arrangement_end_tick": {
      "type": "integer",
      "minimum": 1
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "buses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bus"
      }
    },
    "master_bus_id": {
      "type": "string",
      "minLength": 1
    },
    "processors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/processor"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "plugin_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "registry_id",
          "state_sha256"
        ],
        "properties": {
          "registry_id": {
            "type": "string"
          },
          "state_sha256": {
            "$ref": "#/$defs/hash"
          },
          "expected_vendor": {
            "type": "string"
          },
          "expected_version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "quality_profile_id": {
      "type": "string"
    },
    "brief_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_tick",
        "duration_ticks",
        "velocity",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        },
        "note": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "route_bus_id",
        "events",
        "insert_processor_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "sample",
            "midi_instrument",
            "audio"
          ]
        },
        "route_bus_id": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "insert_processor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instrument_processor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "audio_asset_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "insert_processor_ids",
        "output_bus_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "insert_processor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_bus_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "reference_id",
        "enabled",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "built_in",
            "faust",
            "vst"
          ]
        },
        "reference_id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "automation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lane_id",
              "parameter_binding_id",
              "points"
            ],
            "properties": {
              "lane_id": {
                "type": "string"
              },
              "parameter_binding_id": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "tick",
                    "value"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "tick": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "value": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "runtime",
        "source_sha256"
      ],
      "properties": {
        "module_id": {
          "type": "string"
        },
        "runtime": {
          "enum": [
            "faust"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "kind",
        "media_type"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "kind": {
          "enum": [
            "imported",
            "recorded",
            "generated",
            "frozen"
          ]
        },
        "media_type": {
          "type": "string"
        },
        "channels": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sample_rate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
