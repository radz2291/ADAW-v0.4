{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaw.local/contracts/plugin-capability.v0.4.schema.json",
  "title": "ADAW Draft Plugin Capability Report v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "name",
    "format",
    "platform",
    "host_path",
    "binary_sha256",
    "trust_status",
    "compatibility",
    "parameter_catalog",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": "adaw.plugin_capability@0.4"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "vendor": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "enum": [
        "vst3",
        "vst2_dll"
      ]
    },
    "platform": {
      "const": "windows-x64"
    },
    "host_path": {
      "type": "string",
      "minLength": 1
    },
    "binary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trust_status": {
      "enum": [
        "unapproved",
        "approved",
        "blocked"
      ]
    },
    "compatibility": {
      "enum": [
        "unscanned",
        "scanned",
        "tested_compatible",
        "limited",
        "incompatible",
        "missing"
      ]
    },
    "plugin_role": {
      "enum": [
        "instrument",
        "effect",
        "unknown"
      ]
    },
    "parameter_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "binding_id",
          "host_index",
          "name",
          "normalized_min",
          "normalized_max"
        ],
        "additionalProperties": false,
        "properties": {
          "binding_id": {
            "type": "string"
          },
          "host_index": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "normalized_min": {
            "const": 0
          },
          "normalized_max": {
            "const": 1
          },
          "display_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "semantics_verified": {
            "type": "boolean"
          },
          "automatable": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pass",
          "fail",
          "blocked",
          "not_evaluated"
        ]
      }
    },
    "scanner_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
